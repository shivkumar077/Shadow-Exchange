{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shadow-exchange-1.onrender.com/api/$1"
    },
    {
      "source": "/orders/(.*)",
      "destination": "https://shadow-exchange-1.onrender.com/orders/$1"
    },
    {
      "source": "/oauth2/(.*)",
      "destination": "https://shadow-exchange-1.onrender.com/oauth2/$1"
    },
    {
      "source": "/login/(.*)",
      "destination": "https://shadow-exchange-1.onrender.com/login/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
